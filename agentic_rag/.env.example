# Required
GROQ_API_KEY=
PINECONE_API_KEY=

# Required for the agent loop's web-search fallback tool (Phase 2+)
TAVILY_API_KEY=

# Optional (defaults shown in src/agentic_rag/config.py)
PINECONE_INDEX_NAME=agentic-rag-kb
DATABASE_PATH=./data/registry.db
REQUEST_TIMEOUT_SECONDS=15
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=4
LLM_MODEL=openai/gpt-oss-20b
HYBRID_RETRIEVAL_ENABLED=false
RERANKING_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CONTEXTUAL_CHUNKING_ENABLED=false
AGENT_MAX_STEPS=6
